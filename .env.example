FASHN_API_KEY=your_fashn_api_key_here
# گزینه چینی OutfitAnyone؛ مقدار provider را برای استفاده از آن dashscope بگذارید.
TRYON_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_china_beijing_dashscope_key_here
DASHSCOPE_MODEL=aitryon
# اگر کنسول یک Workspace endpoint اختصاصی داد، آدرس آن را اینجا قرار دهید.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
NEXT_PUBLIC_LIVE_DEMO_ENABLED=false
